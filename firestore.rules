rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- GLOBAL HARDENED HELPERS ---
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidFollowId(id) {
      return id is string && id.size() > 0 && id.size() <= 260 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn()
        && request.auth.token.email == 'frassa.wwindows@gmail.com'
        && request.auth.token.email_verified == true;
    }

    function isValidUserProfile(data) {
      return data.keys().hasAll(['email', 'displayName'])
        && data.keys().hasOnly([
          'uid',
          'id',
          'name',
          'displayName',
          'email',
          'emailVerified',
          'picture',
          'photoURL',
          'joinedAt',
          'role',
          'favoriteGenre',
          'bio',
          'whatsapp',
          'birthday',
          'location',
          'headline',
          'watchTimeMinutes',
          'updatedAt'
        ])
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 254
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 120
        && (!('uid' in data) || (data.uid is string && data.uid.size() <= 128 && data.uid == request.auth.uid))
        && (!('id' in data) || (data.id is string && data.id.size() <= 128 && data.id == request.auth.uid))
        && (!('name' in data) || (data.name is string && data.name.size() <= 120))
        && (!('bio' in data) || (data.bio is string && data.bio.size() <= 500))
        && (!('favoriteGenre' in data) || (data.favoriteGenre is string && data.favoriteGenre.size() <= 80))
        && (!('whatsapp' in data) || (data.whatsapp is string && data.whatsapp.size() <= 32))
        && (!('birthday' in data) || (data.birthday is string && data.birthday.size() <= 60))
        && (!('location' in data) || (data.location is string && data.location.size() <= 120))
        && (!('headline' in data) || (data.headline is string && data.headline.size() <= 120))
        && (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 1000))
        && (!('picture' in data) || (data.picture is string && data.picture.size() <= 1000))
        && (!('emailVerified' in data) || data.emailVerified is bool)
        && (!('role' in data) || (data.role is string && data.role.size() <= 40))
        && (!('joinedAt' in data) || data.joinedAt is int || data.joinedAt is float)
        && (!('updatedAt' in data) || data.updatedAt is int || data.updatedAt is float)
        && (!('watchTimeMinutes' in data) || data.watchTimeMinutes is int || data.watchTimeMinutes is float);
    }

    function isValidPublicProfile(data) {
      return data.keys().hasAll(['uid', 'displayName', 'isDiscoverable', 'updatedAt'])
        && data.keys().hasOnly([
          'uid',
          'displayName',
          'photoURL',
          'role',
          'headline',
          'birthday',
          'location',
          'favoriteGenre',
          'bio',
          'whatsapp',
          'isVerified',
          'isDiscoverable',
          'savedCount',
          'joinedAt',
          'updatedAt'
        ])
        && isValidId(data.uid)
        && data.uid == request.auth.uid
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 120
        && (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 1000))
        && (!('role' in data) || (data.role is string && data.role.size() <= 40))
        && (!('headline' in data) || (data.headline is string && data.headline.size() <= 120))
        && (!('birthday' in data) || (data.birthday is string && data.birthday.size() <= 60))
        && (!('location' in data) || (data.location is string && data.location.size() <= 120))
        && (!('favoriteGenre' in data) || (data.favoriteGenre is string && data.favoriteGenre.size() <= 80))
        && (!('bio' in data) || (data.bio is string && data.bio.size() <= 500))
        && (!('whatsapp' in data) || (data.whatsapp is string && data.whatsapp.size() <= 32))
        && (!('isVerified' in data) || data.isVerified is bool)
        && data.isDiscoverable is bool
        && (!('savedCount' in data) || (data.savedCount is int || data.savedCount is float))
        && (!('joinedAt' in data) || (data.joinedAt is int || data.joinedAt is float))
        && (data.updatedAt is int || data.updatedAt is float);
    }

    function isValidUserFollow(data) {
      return data.keys().hasAll(['id', 'followerUid', 'targetUid', 'isActive', 'createdAt'])
        && data.keys().hasOnly([
          'id',
          'followerUid',
          'targetUid',
          'followerName',
          'followerAvatar',
          'targetName',
          'targetAvatar',
          'isActive',
          'createdAt'
        ])
        && isValidFollowId(data.id)
        && isValidId(data.followerUid)
        && data.followerUid == request.auth.uid
        && isValidId(data.targetUid)
        && data.targetUid != data.followerUid
        && data.id == data.followerUid + '_' + data.targetUid
        && (!('followerName' in data) || (data.followerName is string && data.followerName.size() <= 120))
        && (!('followerAvatar' in data) || (data.followerAvatar is string && data.followerAvatar.size() <= 1000))
        && (!('targetName' in data) || (data.targetName is string && data.targetName.size() <= 120))
        && (!('targetAvatar' in data) || (data.targetAvatar is string && data.targetAvatar.size() <= 1000))
        && data.isActive is bool
        && (data.createdAt is int || data.createdAt is float);
    }

    function isValidUserStory(data) {
      return data.keys().hasAll([
          'id',
          'authorUid',
          'authorName',
          'mediaType',
          'isActive',
          'createdAt',
          'expiresAt'
        ])
        && data.keys().hasOnly([
          'id',
          'authorUid',
          'authorName',
          'authorAvatar',
          'authorVerified',
          'mediaType',
          'caption',
          'imageUrl',
          'bgGradient',
          'linkedMediaId',
          'linkedMediaTitle',
          'linkedMediaPoster',
          'isActive',
          'createdAt',
          'expiresAt'
        ])
        && isValidId(data.id)
        && isValidId(data.authorUid)
        && data.authorUid == request.auth.uid
        && data.authorName is string && data.authorName.size() >= 1 && data.authorName.size() <= 120
        && (!('authorAvatar' in data) || (data.authorAvatar is string && data.authorAvatar.size() <= 1000))
        && (!('authorVerified' in data) || data.authorVerified is bool)
        && data.mediaType is string && data.mediaType in ['text', 'image', 'movie']
        && (!('caption' in data) || (data.caption is string && data.caption.size() <= 400))
        && (!('imageUrl' in data) || (data.imageUrl is string && data.imageUrl.size() <= 2000))
        && (!('bgGradient' in data) || (data.bgGradient is string && data.bgGradient.size() <= 120))
        && (!('linkedMediaId' in data) || (data.linkedMediaId is string && data.linkedMediaId.size() <= 128))
        && (!('linkedMediaTitle' in data) || (data.linkedMediaTitle is string && data.linkedMediaTitle.size() <= 200))
        && (!('linkedMediaPoster' in data) || (data.linkedMediaPoster is string && data.linkedMediaPoster.size() <= 2000))
        && data.isActive is bool
        && (data.createdAt is int || data.createdAt is float)
        && (data.expiresAt is int || data.expiresAt is float);
    }

    function isValidConversation(data) {
      return data.keys().hasAll(['id', 'participants', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly([
          'id',
          'participants',
          'lastMessage',
          'lastSenderUid',
          'createdAt',
          'updatedAt'
        ])
        && isValidId(data.id)
        && data.participants is list
        && data.participants.size() == 2
        && isValidId(data.participants[0])
        && isValidId(data.participants[1])
        && data.participants[0] != data.participants[1]
        && (!('lastMessage' in data) || (data.lastMessage is string && data.lastMessage.size() <= 500))
        && (!('lastSenderUid' in data) || (isValidId(data.lastSenderUid) && data.lastSenderUid in data.participants))
        && (data.createdAt is int || data.createdAt is float)
        && (data.updatedAt is int || data.updatedAt is float);
    }

    function isValidDirectMessage(data) {
      return data.keys().hasAll(['id', 'senderUid', 'senderName', 'text', 'participants', 'createdAt'])
        && data.keys().hasOnly([
          'id',
          'senderUid',
          'senderName',
          'text',
          'participants',
          'createdAt'
        ])
        && isValidId(data.id)
        && isValidId(data.senderUid)
        && data.senderUid == request.auth.uid
        && data.senderName is string && data.senderName.size() >= 1 && data.senderName.size() <= 120
        && data.text is string && data.text.size() >= 1 && data.text.size() <= 1500
        && data.participants is list
        && data.participants.size() == 2
        && isValidId(data.participants[0])
        && isValidId(data.participants[1])
        && request.auth.uid in data.participants
        && (data.createdAt is int || data.createdAt is float);
    }

    function isValidMovie(data) {
      return data.keys().hasAll(['titleAr'])
        && data.keys().hasOnly([
          'id',
          'title',
          'titleAr',
          'originalTitle',
          'type',
          'description',
          'posterUrl',
          'bannerUrl',
          'videoUrl',
          'videoQuality',
          'ageRating',
          'duration',
          'year',
          'rating',
          'genres',
          'isPublished',
          'fileSizeBytes',
          'storagePath',
          'storageType',
          'isLatest',
          'isFeatured',
          'isMostWatched',
          'isComingSoon',
          'displayOrder',
          'viewsCount',
          'director',
          'cast',
          'seasons',
          'sources',
          'introStart',
          'introEnd',
          'subtitleUrl',
          'createdAt',
          'updatedAt'
        ])
        && data.titleAr is string && data.titleAr.size() >= 1 && data.titleAr.size() <= 200
        && (!('videoUrl' in data) || (data.videoUrl is string && data.videoUrl.size() <= 2000))
        && (!('id' in data) || (data.id is string && data.id.size() <= 128))
        && (!('title' in data) || (data.title is string && data.title.size() <= 200))
        && (!('originalTitle' in data) || (data.originalTitle is string && data.originalTitle.size() <= 200))
        && (!('type' in data) || (data.type is string && data.type.size() <= 40))
        && (!('description' in data) || (data.description is string && data.description.size() <= 5000))
        && (!('posterUrl' in data) || (data.posterUrl is string && data.posterUrl.size() <= 2000))
        && (!('bannerUrl' in data) || (data.bannerUrl is string && data.bannerUrl.size() <= 2000))
        && (!('videoQuality' in data) || (data.videoQuality is string && data.videoQuality.size() <= 60))
        && (!('ageRating' in data) || (data.ageRating is string && data.ageRating.size() <= 20))
        && (!('duration' in data) || (data.duration is string && data.duration.size() <= 60))
        && (!('storagePath' in data) || (data.storagePath is string && data.storagePath.size() <= 500))
        && (!('storageType' in data) || (data.storageType is string && data.storageType.size() <= 40))
        && (!('director' in data) || (data.director is string && data.director.size() <= 200))
        && (!('subtitleUrl' in data) || (data.subtitleUrl is string && data.subtitleUrl.size() <= 2000))
        && (!('year' in data) || data.year is int || data.year is float)
        && (!('rating' in data) || data.rating is int || data.rating is float)
        && (!('displayOrder' in data) || data.displayOrder is int || data.displayOrder is float)
        && (!('viewsCount' in data) || data.viewsCount is int || data.viewsCount is float)
        && (!('introStart' in data) || data.introStart is int || data.introStart is float)
        && (!('introEnd' in data) || data.introEnd is int || data.introEnd is float)
        && (!('fileSizeBytes' in data) || data.fileSizeBytes is int || data.fileSizeBytes is float)
        && (!('createdAt' in data) || data.createdAt is int || data.createdAt is float)
        && (!('updatedAt' in data) || data.updatedAt is int || data.updatedAt is float)
        && (!('genres' in data) || (data.genres is list && data.genres.size() <= 20 && (data.genres.size() == 0 || data.genres[0] is string)))
        && (!('cast' in data) || (data.cast is list && data.cast.size() <= 40 && (data.cast.size() == 0 || data.cast[0] is string)))
        && (!('seasons' in data) || (data.seasons is list && data.seasons.size() <= 50))
        && (!('sources' in data) || (data.sources is list && data.sources.size() <= 15))
        && (!('isPublished' in data) || data.isPublished is bool)
        && (!('isLatest' in data) || data.isLatest is bool)
        && (!('isFeatured' in data) || data.isFeatured is bool)
        && (!('isMostWatched' in data) || data.isMostWatched is bool)
        && (!('isComingSoon' in data) || data.isComingSoon is bool);
    }

    function isValidUserAlert(data) {
      return data.keys().hasAll([
          'mediaId',
          'mediaTitle',
          'mediaType',
          'knownEpisodeCount',
          'hadVideo',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'mediaId',
          'mediaTitle',
          'mediaType',
          'posterUrl',
          'knownEpisodeCount',
          'hadVideo',
          'knownUpdatedAt',
          'createdAt',
          'updatedAt'
        ])
        && isValidId(data.mediaId)
        && data.mediaTitle is string && data.mediaTitle.size() >= 1 && data.mediaTitle.size() <= 200
        && data.mediaType is string && data.mediaType in ['movie', 'series', 'anime']
        && (!('posterUrl' in data) || (data.posterUrl is string && data.posterUrl.size() <= 2000))
        && (data.knownEpisodeCount is int || data.knownEpisodeCount is float)
        && data.knownEpisodeCount >= 0
        && data.hadVideo is bool
        && (!('knownUpdatedAt' in data) || data.knownUpdatedAt is int || data.knownUpdatedAt is float)
        && (data.createdAt is int || data.createdAt is float)
        && (data.updatedAt is int || data.updatedAt is float);
    }

    function isValidUserNotification(data) {
      return data.keys().hasAll(['id', 'mediaId', 'title', 'message', 'kind', 'read', 'createdAt'])
        && data.keys().hasOnly([
          'id',
          'mediaId',
          'mediaTitle',
          'mediaType',
          'posterUrl',
          'title',
          'message',
          'kind',
          'read',
          'episodeNumber',
          'seasonNumber',
          'createdAt'
        ])
        && isValidId(data.id)
        && isValidId(data.mediaId)
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 200
        && data.message is string && data.message.size() >= 1 && data.message.size() <= 1000
        && (!('mediaTitle' in data) || (data.mediaTitle is string && data.mediaTitle.size() <= 200))
        && (!('mediaType' in data) || (data.mediaType is string && data.mediaType in ['movie', 'series', 'anime']))
        && (!('posterUrl' in data) || (data.posterUrl is string && data.posterUrl.size() <= 2000))
        && data.kind is string && data.kind in ['new_episode', 'movie_added', 'media_updated']
        && data.read is bool
        && (!('episodeNumber' in data) || data.episodeNumber is int || data.episodeNumber is float)
        && (!('seasonNumber' in data) || data.seasonNumber is int || data.seasonNumber is float)
        && (data.createdAt is int || data.createdAt is float);
    }

    // Test connection document for initial validation
    match /test/{docId} {
      allow get: if isValidId(docId);
      allow list: if false;
      allow write: if false;
    }

    // Private User Accounts: strictly isolated per authenticated owner (and admin)
    match /users/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isAdmin();
      allow create: if isValidId(userId)
        && isOwner(userId)
        && isValidUserProfile(incoming())
        && (!('role' in incoming()) || incoming().role == 'عضو مسجل' || isAdmin());
      allow update: if isValidId(userId)
        && isValidUserProfile(incoming())
        && (
          isAdmin() ||
          (
            isOwner(userId)
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'displayName',
              'name',
              'bio',
              'favoriteGenre',
              'whatsapp',
              'birthday',
              'location',
              'headline',
              'photoURL',
              'picture',
              'emailVerified',
              'updatedAt'
            ])
            && (!('role' in incoming()) || incoming().role == existing().role)
          )
        );
      allow delete: if isValidId(userId) && (isOwner(userId) || isAdmin());

      // User private subcollections (favorites, watch history)
      match /favorites/{favoriteId} {
        allow get, create, update, delete: if isValidId(userId) && isValidId(favoriteId) && isOwner(userId);
        allow list: if isValidId(userId) && isOwner(userId);
      }

      match /history/{historyId} {
        allow get, create, update, delete: if isValidId(userId) && isValidId(historyId) && isOwner(userId);
        allow list: if isValidId(userId) && isOwner(userId);
      }

      match /alerts/{alertId} {
        allow get: if isValidId(userId) && isValidId(alertId) && isOwner(userId);
        allow list: if isValidId(userId) && isOwner(userId);
        allow create: if isValidId(userId) && isValidId(alertId) && isOwner(userId)
          && isValidUserAlert(incoming())
          && incoming().mediaId == alertId;
        allow update: if isValidId(userId) && isValidId(alertId) && isOwner(userId)
          && isValidUserAlert(incoming())
          && incoming().mediaId == existing().mediaId
          && incoming().createdAt == existing().createdAt
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'mediaTitle',
            'posterUrl',
            'knownEpisodeCount',
            'hadVideo',
            'knownUpdatedAt',
            'updatedAt'
          ]);
        allow delete: if isValidId(userId) && isValidId(alertId) && isOwner(userId);
      }

      match /notifications/{notificationId} {
        allow get: if isValidId(userId) && isValidId(notificationId) && isOwner(userId);
        allow list: if isValidId(userId) && isOwner(userId);
        allow create: if isValidId(userId) && isValidId(notificationId) && isOwner(userId)
          && isValidUserNotification(incoming())
          && incoming().id == notificationId;
        allow update: if isValidId(userId) && isValidId(notificationId) && isOwner(userId)
          && isValidUserNotification(incoming())
          && incoming().id == existing().id
          && incoming().mediaId == existing().mediaId
          && incoming().createdAt == existing().createdAt
          && incoming().diff(existing()).affectedKeys().hasOnly(['read']);
        allow delete: if isValidId(userId) && isValidId(notificationId) && isOwner(userId);
      }
    }

    // Public Non-PII Member Profiles (Pillar 6 PII Isolation: no email field stored here)
    match /publicProfiles/{userId} {
      allow get: if isValidId(userId);
      allow list: if resource.data.isDiscoverable == true;
      allow create: if isValidId(userId)
        && isOwner(userId)
        && isValidPublicProfile(incoming())
        && incoming().uid == userId
        && (!('role' in incoming()) || incoming().role == 'عضو مسجل' || isAdmin())
        && (!('isVerified' in incoming()) || incoming().isVerified == (request.auth.token.email_verified == true) || isAdmin());
      allow update: if isValidId(userId)
        && isValidPublicProfile(incoming())
        && (
          isAdmin() ||
          (
            isOwner(userId)
            && incoming().uid == existing().uid
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'displayName',
              'photoURL',
              'headline',
              'birthday',
              'location',
              'favoriteGenre',
              'bio',
              'whatsapp',
              'isDiscoverable',
              'savedCount',
              'isVerified',
              'updatedAt'
            ])
            && (!('isVerified' in incoming()) || incoming().isVerified == (request.auth.token.email_verified == true))
          )
        );
      allow delete: if isValidId(userId) && (isOwner(userId) || isAdmin());
    }

    // Follow Graph
    match /follows/{followId} {
      allow get: if isValidFollowId(followId);
      allow list: if resource.data.isActive == true;
      allow create: if isSignedIn()
        && isValidFollowId(followId)
        && isValidUserFollow(incoming())
        && incoming().id == followId
        && exists(/databases/$(database)/documents/publicProfiles/$(incoming().targetUid));
      allow update: if isSignedIn()
        && isValidFollowId(followId)
        && isValidUserFollow(incoming())
        && existing().followerUid == request.auth.uid
        && incoming().id == existing().id
        && incoming().followerUid == existing().followerUid
        && incoming().targetUid == existing().targetUid
        && incoming().createdAt == existing().createdAt
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'isActive',
          'followerName',
          'followerAvatar',
          'targetName',
          'targetAvatar'
        ]);
      allow delete: if isSignedIn() && isValidFollowId(followId) && (existing().followerUid == request.auth.uid || isAdmin());
    }

    // Member Stories
    match /stories/{storyId} {
      allow get: if isValidId(storyId);
      allow list: if resource.data.isActive == true;
      allow create: if isSignedIn()
        && isValidId(storyId)
        && isValidUserStory(incoming())
        && incoming().id == storyId;
      allow update: if isSignedIn()
        && isValidId(storyId)
        && isValidUserStory(incoming())
        && (
          isAdmin() ||
          (
            existing().authorUid == request.auth.uid
            && incoming().id == existing().id
            && incoming().authorUid == existing().authorUid
            && incoming().createdAt == existing().createdAt
            && incoming().diff(existing()).affectedKeys().hasOnly(['caption', 'isActive'])
          )
        );
      allow delete: if isSignedIn() && isValidId(storyId) && (existing().authorUid == request.auth.uid || isAdmin());
    }

    // Direct Conversations & Messages (Pillar 1 Master Gate)
    match /conversations/{conversationId} {
      function isParentParticipant() {
        return isSignedIn()
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants;
      }

      allow get: if isSignedIn() && isValidId(conversationId) && request.auth.uid in existing().participants;
      allow list: if isSignedIn() && request.auth.uid in resource.data.participants;
      allow create: if isSignedIn()
        && isValidId(conversationId)
        && isValidConversation(incoming())
        && incoming().id == conversationId
        && request.auth.uid in incoming().participants;
      allow update: if isSignedIn()
        && isValidId(conversationId)
        && isValidConversation(incoming())
        && request.auth.uid in existing().participants
        && incoming().id == existing().id
        && incoming().participants == existing().participants
        && incoming().createdAt == existing().createdAt
        && incoming().diff(existing()).affectedKeys().hasOnly(['lastMessage', 'lastSenderUid', 'updatedAt']);
      allow delete: if isAdmin() && isValidId(conversationId);

      match /messages/{messageId} {
        allow get: if isValidId(conversationId) && isValidId(messageId) && isParentParticipant();
        allow list: if isValidId(conversationId) && isSignedIn() && request.auth.uid in resource.data.participants;
        allow create: if isValidId(conversationId)
          && isValidId(messageId)
          && isValidDirectMessage(incoming())
          && incoming().id == messageId
          && isParentParticipant()
          && incoming().participants == get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants;
        allow delete: if isValidId(conversationId) && isValidId(messageId) && isSignedIn() && (existing().senderUid == request.auth.uid || isAdmin());
      }
    }

    // Movies & Series Collection: Public read for streaming, strictly developer-admin write
    match /movies/{movieId} {
      allow get: if isValidId(movieId);
      allow list: if true;
      allow create, update: if isAdmin() && isValidId(movieId) && isValidMovie(incoming());
      allow delete: if isAdmin() && isValidId(movieId);
    }

    // Public Site Settings & Categories: Public read, strictly developer-admin write
    match /siteSettings/{settingId} {
      allow get: if isValidId(settingId);
      allow list: if false;
      allow create, update, delete: if isAdmin() && isValidId(settingId);
    }
  }
}
