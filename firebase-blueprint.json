{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Private user account profile document stored in Firestore",
      "type": "object",
      "properties": {
        "displayName": {
          "type": "string",
          "description": "User display name"
        },
        "email": {
          "type": "string",
          "description": "User email address"
        },
        "emailVerified": {
          "type": "boolean",
          "description": "Whether email is verified"
        },
        "photoURL": {
          "type": "string",
          "description": "Avatar image URL"
        },
        "role": {
          "type": "string",
          "enum": ["member", "admin"],
          "description": "User account role"
        },
        "bio": {
          "type": "string",
          "description": "Short user bio"
        },
        "favoriteGenre": {
          "type": "string",
          "description": "Favorite film genre"
        },
        "whatsapp": {
          "type": "string",
          "maxLength": 32,
          "description": "Optional WhatsApp contact number configured in settings"
        },
        "birthday": {
          "type": "string",
          "maxLength": 60,
          "description": "User birthday display string"
        },
        "location": {
          "type": "string",
          "maxLength": 120,
          "description": "User city or country"
        },
        "headline": {
          "type": "string",
          "maxLength": 120,
          "description": "User subtitle or role headline"
        },
        "createdAt": {
          "type": "string",
          "description": "Account creation timestamp"
        },
        "updatedAt": {
          "type": "string",
          "description": "Last profile update timestamp"
        }
      },
      "required": ["email", "displayName"]
    },
    "PublicProfile": {
      "title": "PublicProfile",
      "description": "Publicly visible non-PII member profile card for MASHHAD social features",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Owner Firebase UID"
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "description": "Public display name"
        },
        "photoURL": {
          "type": "string",
          "maxLength": 1000,
          "description": "Public avatar image URL"
        },
        "role": {
          "type": "string",
          "maxLength": 40,
          "description": "Public member badge label"
        },
        "headline": {
          "type": "string",
          "maxLength": 120,
          "description": "Public short headline or status"
        },
        "birthday": {
          "type": "string",
          "maxLength": 60,
          "description": "Optional birthday label"
        },
        "location": {
          "type": "string",
          "maxLength": 120,
          "description": "Optional location label"
        },
        "favoriteGenre": {
          "type": "string",
          "maxLength": 80,
          "description": "Favorite cinema genre"
        },
        "bio": {
          "type": "string",
          "maxLength": 500,
          "description": "Public multi-line bio highlights"
        },
        "whatsapp": {
          "type": "string",
          "maxLength": 32,
          "description": "Optional public WhatsApp number opted-in via Settings"
        },
        "isVerified": {
          "type": "boolean",
          "description": "Verified badge indicator"
        },
        "isDiscoverable": {
          "type": "boolean",
          "description": "Whether profile appears in member discovery"
        },
        "savedCount": {
          "type": "number",
          "description": "Number of saved movies"
        },
        "joinedAt": {
          "type": "number",
          "description": "Joined timestamp"
        },
        "updatedAt": {
          "type": "number",
          "description": "Last update timestamp"
        }
      },
      "required": ["uid", "displayName", "isDiscoverable", "updatedAt"]
    },
    "UserFollow": {
      "title": "UserFollow",
      "description": "Follow relationship document between two users",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 260,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Composite ID followerUid_targetUid"
        },
        "followerUid": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Follower user UID"
        },
        "targetUid": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Followed user UID"
        },
        "followerName": {
          "type": "string",
          "maxLength": 120,
          "description": "Follower display name"
        },
        "followerAvatar": {
          "type": "string",
          "maxLength": 1000,
          "description": "Follower avatar URL"
        },
        "targetName": {
          "type": "string",
          "maxLength": 120,
          "description": "Target display name"
        },
        "targetAvatar": {
          "type": "string",
          "maxLength": 1000,
          "description": "Target avatar URL"
        },
        "isActive": {
          "type": "boolean",
          "description": "Whether follow link is active"
        },
        "createdAt": {
          "type": "number",
          "description": "Follow creation timestamp"
        }
      },
      "required": ["id", "followerUid", "targetUid", "isActive", "createdAt"]
    },
    "UserStory": {
      "title": "UserStory",
      "description": "User story post (photo, text status, or movie recommendation card)",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Story document ID"
        },
        "authorUid": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Story author UID"
        },
        "authorName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "description": "Story author name"
        },
        "authorAvatar": {
          "type": "string",
          "maxLength": 1000,
          "description": "Story author avatar URL"
        },
        "authorVerified": {
          "type": "boolean",
          "description": "Whether author has verified badge"
        },
        "mediaType": {
          "type": "string",
          "enum": ["text", "image", "movie"],
          "description": "Story card type"
        },
        "caption": {
          "type": "string",
          "maxLength": 400,
          "description": "Story text or caption"
        },
        "imageUrl": {
          "type": "string",
          "maxLength": 2000,
          "description": "Uploaded or external image URL"
        },
        "bgGradient": {
          "type": "string",
          "maxLength": 120,
          "description": "Gradient theme identifier"
        },
        "linkedMediaId": {
          "type": "string",
          "maxLength": 128,
          "description": "Optional attached movie or series ID"
        },
        "linkedMediaTitle": {
          "type": "string",
          "maxLength": 200,
          "description": "Optional attached movie or series title"
        },
        "linkedMediaPoster": {
          "type": "string",
          "maxLength": 2000,
          "description": "Optional attached movie poster URL"
        },
        "isActive": {
          "type": "boolean",
          "description": "Story active visibility flag"
        },
        "createdAt": {
          "type": "number",
          "description": "Story creation timestamp"
        },
        "expiresAt": {
          "type": "number",
          "description": "Story expiration timestamp"
        }
      },
      "required": ["id", "authorUid", "authorName", "mediaType", "isActive", "createdAt", "expiresAt"]
    },
    "DirectConversation": {
      "title": "DirectConversation",
      "description": "Direct messaging conversation between two members",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Sorted composite conversation ID"
        },
        "participants": {
          "type": "string",
          "description": "Bounded 2-element array of participant UIDs"
        },
        "lastMessage": {
          "type": "string",
          "maxLength": 500,
          "description": "Latest message preview"
        },
        "lastSenderUid": {
          "type": "string",
          "maxLength": 128,
          "description": "UID of latest sender"
        },
        "createdAt": {
          "type": "number",
          "description": "Conversation creation timestamp"
        },
        "updatedAt": {
          "type": "number",
          "description": "Conversation last message timestamp"
        }
      },
      "required": ["id", "participants", "createdAt", "updatedAt"]
    },
    "DirectMessage": {
      "title": "DirectMessage",
      "description": "Single message inside a direct conversation",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Message ID"
        },
        "senderUid": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Sender UID"
        },
        "senderName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "description": "Sender display name"
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1500,
          "description": "Message content"
        },
        "participants": {
          "type": "string",
          "description": "Bounded 2-element array matching parent conversation participants"
        },
        "createdAt": {
          "type": "number",
          "description": "Message creation timestamp"
        }
      },
      "required": ["id", "senderUid", "senderName", "text", "participants", "createdAt"]
    },
    "UserFavorite": {
      "title": "UserFavorite",
      "description": "Private favorite media item for a user",
      "type": "object",
      "properties": {
        "mediaId": {
          "type": "string",
          "description": "ID of the favorited media"
        },
        "title": {
          "type": "string",
          "description": "Title of the media"
        },
        "posterUrl": {
          "type": "string",
          "description": "Poster URL"
        },
        "createdAt": {
          "type": "string",
          "description": "Timestamp when added"
        }
      },
      "required": ["mediaId"]
    },
    "UserHistory": {
      "title": "UserHistory",
      "description": "Private watch history item for a user",
      "type": "object",
      "properties": {
        "mediaId": {
          "type": "string",
          "description": "ID of the played media"
        },
        "currentTime": {
          "type": "number",
          "description": "Current playback position in seconds"
        },
        "duration": {
          "type": "number",
          "description": "Total duration in seconds"
        },
        "updatedAt": {
          "type": "string",
          "description": "Timestamp when last watched"
        }
      },
      "required": ["mediaId", "currentTime"]
    },
    "MovieItem": {
      "title": "MovieItem",
      "description": "Cinema movie record in MASHHAD catalog",
      "type": "object",
      "properties": {
        "title": { "type": "string", "description": "English or original title" },
        "titleAr": { "type": "string", "description": "Arabic display title" },
        "description": { "type": "string", "description": "Movie synopsis" },
        "posterUrl": { "type": "string", "description": "Poster image URL" },
        "bannerUrl": { "type": "string", "description": "Banner background image URL" },
        "videoUrl": { "type": "string", "description": "Streaming video URL" },
        "videoQuality": { "type": "string", "description": "Quality badge like 4K or 1080p" },
        "ageRating": { "type": "string", "description": "Age rating like +16" },
        "duration": { "type": "string", "description": "Formatted duration" },
        "year": { "type": "number", "description": "Release year" },
        "rating": { "type": "number", "description": "Rating score out of 10" },
        "genres": { "type": "string", "description": "List of genre keys" },
        "isPublished": { "type": "boolean", "description": "Whether visible to public visitors" },
        "isFeatured": { "type": "boolean", "description": "Featured on hero banner" },
        "isLatest": { "type": "boolean", "description": "Included in latest releases" },
        "isMostWatched": { "type": "boolean", "description": "Highlighted as most watched" },
        "isComingSoon": { "type": "boolean", "description": "Published teaser awaiting video release" },
        "displayOrder": { "type": "number", "description": "Custom sort order in catalog" },
        "viewsCount": { "type": "number", "description": "Recorded total playback views" },
        "director": { "type": "string", "description": "Director name" },
        "fileSizeBytes": { "type": "number", "description": "Video file size in bytes" },
        "createdAt": { "type": "number", "description": "Creation timestamp" },
        "updatedAt": { "type": "number", "description": "Last update timestamp" }
      },
      "required": ["titleAr"]
    },
    "UserMediaAlert": {
      "title": "UserMediaAlert",
      "description": "User subscription to be notified when a movie is added or new episodes release",
      "type": "object",
      "properties": {
        "mediaId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$", "description": "Subscribed movie or series ID" },
        "mediaTitle": { "type": "string", "minLength": 1, "maxLength": 200, "description": "Display title of the media" },
        "mediaType": { "type": "string", "enum": ["movie", "series", "anime"], "description": "Media type" },
        "posterUrl": { "type": "string", "maxLength": 2000, "description": "Poster URL" },
        "knownEpisodeCount": { "type": "number", "description": "Episode count snapshot when subscribed or last notified" },
        "hadVideo": { "type": "boolean", "description": "Whether playable video already existed when subscribed" },
        "knownUpdatedAt": { "type": "number", "description": "Last observed media updatedAt timestamp" },
        "createdAt": { "type": "number", "description": "Subscription creation timestamp" },
        "updatedAt": { "type": "number", "description": "Last update timestamp" }
      },
      "required": ["mediaId", "mediaTitle", "mediaType", "knownEpisodeCount", "hadVideo", "createdAt", "updatedAt"]
    },
    "UserNotification": {
      "title": "UserNotification",
      "description": "Triggered release or new episode notification delivered to a user",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$", "description": "Notification document ID" },
        "mediaId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$", "description": "Related movie or series ID" },
        "mediaTitle": { "type": "string", "maxLength": 200, "description": "Title of related media" },
        "mediaType": { "type": "string", "enum": ["movie", "series", "anime"], "description": "Type of related media" },
        "posterUrl": { "type": "string", "maxLength": 2000, "description": "Poster thumbnail URL" },
        "title": { "type": "string", "minLength": 1, "maxLength": 200, "description": "Notification headline" },
        "message": { "type": "string", "minLength": 1, "maxLength": 1000, "description": "Notification body text" },
        "kind": { "type": "string", "enum": ["new_episode", "movie_added", "media_updated"], "description": "Notification category" },
        "read": { "type": "boolean", "description": "Whether user has read this notification" },
        "episodeNumber": { "type": "number", "description": "Newly added episode number if applicable" },
        "seasonNumber": { "type": "number", "description": "Season number if applicable" },
        "createdAt": { "type": "number", "description": "Notification creation timestamp" }
      },
      "required": ["id", "mediaId", "title", "message", "kind", "read", "createdAt"]
    },
    "SiteSettingDoc": {
      "title": "SiteSettingDoc",
      "description": "Platform global appearance and player preferences",
      "type": "object",
      "properties": {
        "siteName": { "type": "string", "description": "Platform brand name" },
        "accentColor": { "type": "string", "description": "Primary hex accent color" },
        "updatedAt": { "type": "number", "description": "Last update timestamp" }
      },
      "required": ["siteName"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "Private user account profile document"
    },
    "/publicProfiles/{userId}": {
      "schema": "PublicProfile",
      "description": "Public non-PII member profile cards for social discovery, stories, and contact links"
    },
    "/follows/{followId}": {
      "schema": "UserFollow",
      "description": "Follow relationships between users"
    },
    "/stories/{storyId}": {
      "schema": "UserStory",
      "description": "User stories (text, photo, or movie recommendation)"
    },
    "/conversations/{conversationId}": {
      "schema": "DirectConversation",
      "description": "Direct messaging threads between two users"
    },
    "/conversations/{conversationId}/messages/{messageId}": {
      "schema": "DirectMessage",
      "description": "Messages within a direct conversation"
    },
    "/users/{userId}/favorites/{favoriteId}": {
      "schema": "UserFavorite",
      "description": "User private bookmarked favorite movies"
    },
    "/users/{userId}/history/{historyId}": {
      "schema": "UserHistory",
      "description": "User private watch history"
    },
    "/users/{userId}/alerts/{alertId}": {
      "schema": "UserMediaAlert",
      "description": "User private release alert subscriptions for movies and series"
    },
    "/users/{userId}/notifications/{notificationId}": {
      "schema": "UserNotification",
      "description": "User private triggered release notifications"
    },
    "/movies/{movieId}": {
      "schema": "MovieItem",
      "description": "Movies & Series catalog collection for public streaming and admin management"
    },
    "/siteSettings/{settingId}": {
      "schema": "SiteSettingDoc",
      "description": "Global site configuration and homepage layout flags"
    }
  }
}
